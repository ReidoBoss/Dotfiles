# ── appearance ──
background-color=#0a0e14cc
border-color=#ffffff12
border-radius=14
border-size=1
text-color=#ffffffd9

# ── typography ──
font=JetBrainsMono Nerd Font 11

# ── layout ──
width=320
height=120
margin=12
padding=12,16

# ── position ──
anchor=top-right

# ── timing ──
default-timeout=5000
ignore-timeout=0

# ── icons ──
icon-path=/usr/share/icons/Papirus-Dark
max-icon-size=32

# ── urgency: low ──
[urgency=low]
background-color=#0a0e14b3
border-color=#ffffff0d
text-color=#ffffffa0
default-timeout=3000

# ── urgency: normal ──
[urgency=normal]
background-color=#0a0e14cc
border-color=#ffffff12
text-color=#ffffffd9

# ── urgency: high ──
[urgency=high]
background-color=#2d0e0ecc
border-color=#f87171aa
text-color=#fca5a5
default-timeout=0
